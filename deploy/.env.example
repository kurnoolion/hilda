# =====================================================================================
# deploy/.env.example -- SANITIZED template per [D-125] Point 3
# =====================================================================================
#
# Copy this file to deploy/.env on the Linux deployment box and fill in real
# corp values. NEVER commit deploy/.env to public github (entry is in
# customizations/.gitignore + top-level .gitignore).
#
# Bring-up:
#   cp deploy/.env.example deploy/.env
#   vi deploy/.env                       # fill real corp values
#   podman-compose --env-file deploy/.env up -d
# =====================================================================================


# ----- Postgres (HILDA's primary persistent store) -----
POSTGRES_USER=hilda
POSTGRES_PASSWORD=__REPLACE_WITH_LOCAL_SECRET__
POSTGRES_DB=hilda


# ----- LLM backend per [D-007] + [D-052] tri-backend -----
# Backend options: mock / vllm / llama_cpp / ollama
# Ph-1 default: mock (returns canned responses for dispatch-path testing).
LLM_BACKEND=mock
LLM_MODEL_PATH=/var/lib/hilda/models


# ----- Reverse proxy origin (corp PC fronts hilda-api) -----
# Set to the corp-net URL ops/TPM browsers will hit.
REVERSE_PROXY_ORIGIN=https://hilda-proxy.corp.example


# ----- Email (IMAP + SMTP via corp Exchange or equivalent) -----
EMAIL_IMAP_HOST=imap.corp.example
EMAIL_IMAP_PORT=993
EMAIL_IMAP_MAILBOX=INBOX

EMAIL_SMTP_HOST=smtp.corp.example
EMAIL_SMTP_PORT=587
EMAIL_FROM_ADDR=hilda-noreply@corp.example


# ----- SharePoint per [D-006] + [D-117] NTLM -----
SP_SITE_URL=https://sp2017.corp.example/sites/hilda
# Real SP creds via sops-encrypted bundle per [D-038] -- NOT here.


# ----- Corp PLM gateway per [D-007] -----
PLM_GATEWAY_URL=https://corp-plm-gateway.corp.example


# ----- Corp messenger gateway per Module #20 + [D-019] -----
MESSENGER_GATEWAY_URL=https://corp-messenger-gateway.corp.example


# ----- ops_alerts per [D-127] -----
# Real ops_bot_email + broadcast_corp_ids live in
# customizations/ops_alerts/recipients.yaml (LOCAL only per Point 3).


# ----- NSD mount path (host SMB/CIFS mount per [D-013]) -----
NSD_HOST_MOUNT=/mnt/nsd


# ----- sops decryption key path (per [D-038]) -----
# Path on host to GPG private key OR age key for sops decryption.
# Used by deploy/sops_decrypt.sh prior to compose up.
SOPS_KEY_FILE=/etc/hilda/sops-keys/private.key


# ----- sops + age key paths per [D-038] + [D-132] (runtime credential decrypt) -----
# Distinct from SOPS_KEY_FILE above which is for the pre-boot sops_decrypt.sh hook.
# These two paths feed bind-mounts in docker-compose.yml so the running containers
# can decrypt customizations/credentials/*.enc.env files via SopsCredentialService
# at startup. The age private key NEVER touches github (it is the master decrypt
# key for every sops-encrypted credential).
#
# HILDA_AGE_KEY_DIR -- HOST directory containing your sops age `keys.txt` file.
# Conventional location is `$HOME/.config/sops/age/` (created by `age-keygen`).
# This directory is bind-mounted READ-ONLY into containers as /etc/hilda/age-key/
# and SOPS_AGE_KEY_FILE env var (set in docker-compose.yml) points to keys.txt
# inside that mount.
HILDA_AGE_KEY_DIR=__REPLACE_WITH_HOST_PATH__   # e.g. /home/youruser/.config/sops/age

# HILDA_CREDENTIALS_DIR -- HOST directory containing *.enc.env files. Defaults to
# `../customizations/credentials` relative to the compose file location, which is
# correct for the standard repo layout; override only if your encrypted credential
# bundle lives elsewhere.
# HILDA_CREDENTIALS_DIR=../customizations/credentials
